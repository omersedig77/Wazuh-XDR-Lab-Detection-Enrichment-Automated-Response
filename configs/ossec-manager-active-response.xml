<!--
  Wazuh Manager — Active Response Configuration
  File: /var/ossec/etc/ossec.conf
  Purpose: Automatically block source IPs on SSH brute force detection
-->

<active-response>
  <command>firewall-drop</command>
  <location>local</location>
  <rules_id>5763,5710,5716,5720</rules_id>
  <timeout>180</timeout>
</active-response>

